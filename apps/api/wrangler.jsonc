{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "b2ccoop-store-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-13",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development"
  },
  /** Enable after R2 is activated: create bucket `b2ccoop-store-images-dev`, set PUBLIC_IMAGES_BASE_URL */
  // "r2_buckets": [{ "binding": "PRODUCT_IMAGES", "bucket_name": "b2ccoop-store-images-dev" }],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8787
  }
}
