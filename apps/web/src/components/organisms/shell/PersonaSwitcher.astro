---
import { PERSONAS } from "@/stores/persona";
---

<div class="relative" data-persona-switcher>
  <button
    type="button"
    data-persona-trigger
    class="touch-target inline-flex items-center gap-2 rounded-lg px-2 py-1 hover:bg-neutral-50 max-w-[12rem] md:max-w-[14rem]"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls="persona-menu"
    aria-label="Account and persona"
  >
    <span
      data-account-initials
      class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700 text-caption font-bold"
      aria-hidden="true"
    >You</span>
    <span class="hidden md:flex min-w-0 flex-col text-left">
      <span class="text-body-sm font-semibold text-neutral-900 truncate" data-persona-label>Customer</span>
      <span class="text-caption text-neutral-500 truncate" data-account-detail>Browse as guest</span>
    </span>
    <svg class="hidden md:block shrink-0 text-neutral-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>
  <ul
    data-persona-menu
    role="listbox"
    class="hidden absolute right-0 top-full z-50 mt-1 w-[min(18rem,calc(100vw-2rem))] rounded-lg border border-neutral-200 bg-neutral-0 py-1 elevation-3"
    aria-label="Persona options"
  >
    <li class="px-4 py-3 border-b border-neutral-100" aria-hidden="true">
      <p class="text-caption font-semibold uppercase tracking-wide text-neutral-500 m-0">Signed in context</p>
      <p class="text-body-sm font-semibold text-neutral-900 m-0 mt-1 truncate" data-account-summary>Customer</p>
      <p class="text-caption text-neutral-500 m-0 mt-0.5" data-account-subtitle>Browse as guest</p>
      <a href="/profile" class="inline-block text-caption text-brand-600 font-semibold no-underline mt-2">Your profile →</a>
    </li>
    {
      PERSONAS.map((p) => (
        <li role="option">
          <button
            type="button"
            class="flex w-full flex-col items-start gap-0.5 px-4 py-3 text-left hover:bg-neutral-50 min-h-touch"
            data-persona-option={p.id}
          >
            <span class="text-body-sm font-semibold text-neutral-900">{p.label}</span>
            <span class="text-caption text-neutral-500">{p.description}</span>
          </button>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { setupAccountSwitcher } from "@/scripts/account-switcher";
  import { API_BASE } from "@/lib/api";
  setupAccountSwitcher(API_BASE);
</script>
