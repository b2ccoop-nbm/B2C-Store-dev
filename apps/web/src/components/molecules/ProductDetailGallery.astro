---
import { categoryIcon } from "@/lib/category-meta";

interface Props {
  id: string;
  imageUrls: string[];
  category: string;
}

const { id, imageUrls, category } = Astro.props;

const images = imageUrls.filter(Boolean).slice(0, 4);
const hasImages = images.length > 0;
---

<div class="product-detail-gallery" data-product-gallery={id}>
  {
    hasImages ? (
      <div class="relative overflow-hidden rounded-xl border border-neutral-200 bg-neutral-100">
        <div class="product-gallery-track flex transition-transform duration-300 ease-out" data-gallery-track>
          {images.map((src, index) => (
            <figure class="min-w-full shrink-0">
              <button
                type="button"
                class="group block w-full"
                data-zoom-open={`product-zoom-${id}-${index}`}
                aria-label={`View product photo ${index + 1} of ${images.length}`}
              >
                <img
                  src={src}
                  alt=""
                  class="aspect-square w-full object-cover lg:aspect-[4/5]"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              </button>
            </figure>
          ))}
        </div>

        {
          images.length > 1 && (
            <>
              <button
                type="button"
                class="product-gallery-prev absolute left-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-neutral-900/55 text-xl text-white hover:bg-neutral-900/75"
                aria-label="Previous photo"
              >
                ‹
              </button>
              <button
                type="button"
                class="product-gallery-next absolute right-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-neutral-900/55 text-xl text-white hover:bg-neutral-900/75"
                aria-label="Next photo"
              >
                ›
              </button>
              <div class="absolute bottom-3 left-0 right-0 flex justify-center gap-2" data-gallery-dots>
                {images.map((_, index) => (
                  <button
                    type="button"
                    class:list={[
                      "h-2.5 w-2.5 rounded-full border border-white/80",
                      index === 0 ? "bg-white" : "bg-white/40",
                    ]}
                    data-gallery-dot={index}
                    aria-label={`Show photo ${index + 1}`}
                  />
                ))}
              </div>
            </>
          )
        }
      </div>
    ) : (
      <div
        class="flex aspect-square items-center justify-center rounded-xl border border-neutral-200 bg-gradient-to-br from-brand-50 to-ecosystem-50 text-6xl lg:aspect-[4/5]"
        aria-hidden="true"
      >
        {categoryIcon(category)}
      </div>
    )
  }

  {
    images.map((src, index) => (
      <dialog
        id={`product-zoom-${id}-${index}`}
        class="image-zoom-dialog fixed inset-0 z-[100] m-0 h-full max-h-none w-full max-w-none border-0 bg-black/90 p-4 backdrop:bg-black/90"
      >
        <form method="dialog" class="flex min-h-full items-center justify-center">
          <button
            type="submit"
            class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/15 text-2xl text-white hover:bg-white/25"
            aria-label="Close image"
          >
            ×
          </button>
          <img src={src} alt="" class="max-h-[88vh] max-w-[min(960px,94vw)] object-contain" />
        </form>
      </dialog>
    ))
  }
</div>

<script>
  import { setupProductGallery } from "@/scripts/product-gallery";
  import { setupProductImageZoom } from "@/scripts/product-image-zoom";
  setupProductGallery();
  setupProductImageZoom();
</script>
