---
import type { CatalogItemPublic } from "@b2ccoop/store-shared";
import OfferingCard from "./OfferingCard.astro";

interface Props {
  item: CatalogItemPublic;
  density?: "compact" | "comfortable";
}

const { item, density = "compact" } = Astro.props;
---

<OfferingCard offering={item} density={density} />
