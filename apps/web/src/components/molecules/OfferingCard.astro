---
import type { CatalogItemPublic } from "@b2ccoop/store-shared";
import Card from "@/components/atoms/Card.astro";
import Button from "@/components/atoms/Button.astro";
import TrustBadge from "@/components/molecules/TrustBadge.astro";
import Price from "@/components/molecules/Price.astro";
import PatronageAmount from "@/components/molecules/PatronageAmount.astro";
import {
  addToCartLabel,
  cartPayloadFromItem,
  isCoopVendor,
  offeringHref,
  patronagePerUnit,
} from "@/lib/offering";
import { categoryIcon } from "@/lib/category-meta";

interface Props {
  offering: CatalogItemPublic;
  layout?: "grid" | "list";
  density?: "compact" | "comfortable";
}

const { offering, layout = "grid", density = "compact" } = Astro.props;
const href = offeringHref(offering);
const cartPayload = cartPayloadFromItem(offering);
const patronage = patronagePerUnit(offering);
const trustType = isCoopVendor(offering.vendorCode) ? "coop-official" : "merchant-verified";
const icon = categoryIcon(offering.category);
const addLabel = addToCartLabel(offering.name);
const isCompact = density === "compact" && layout === "grid";
---

{
  isCompact ? (
    <Card class="group flex h-full flex-col overflow-hidden p-0 transition-shadow hover:shadow-md">
      <div class="relative">
        <a href={href} class="block no-underline text-inherit">
          {
            offering.imageUrl ? (
              <div class="aspect-square overflow-hidden bg-neutral-100">
                <img
                  src={offering.imageUrl}
                  alt=""
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ) : (
              <div
                class="flex aspect-square items-center justify-center bg-gradient-to-br from-brand-50 to-ecosystem-50 text-3xl"
                aria-hidden="true"
              >
                {icon}
              </div>
            )
          }
        </a>
        <div class="pointer-events-none absolute left-1.5 top-1.5 max-w-[calc(100%-3rem)]">
          <TrustBadge type={trustType} class="scale-90 origin-top-left" />
        </div>
        <Button
          type="button"
          variant="primary"
          size="sm"
          class="b2c-add-to-cart absolute bottom-1.5 right-1.5 z-10 h-9 w-9 min-h-0 rounded-full p-0 shadow-md"
          data-cart-item={cartPayload}
          ariaLabel={addLabel}
        >
          <span aria-hidden="true" class="text-lg leading-none">+</span>
        </Button>
      </div>
      <a href={href} class="flex flex-1 flex-col gap-0.5 p-2 no-underline text-inherit">
        <h3 class="text-body-sm m-0 line-clamp-2 font-medium leading-snug">{offering.name}</h3>
        <Price amount={offering.unitPrice} size="sm" />
        <PatronageAmount amount={patronage} class="text-caption text-coop-600" />
      </a>
    </Card>
  ) : (
    <Card class:list={["flex flex-col h-full overflow-hidden p-0", layout === "list" && "sm:flex-row"]}>
      <a href={href} class:list={["no-underline text-inherit block", layout === "grid" ? "flex-1" : "sm:w-36 shrink-0"]}>
        {
          offering.imageUrl ? (
            <div class="relative aspect-square overflow-hidden bg-neutral-100 sm:aspect-[4/3]">
              <img
                src={offering.imageUrl}
                alt=""
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute left-2 top-2 flex flex-wrap gap-1 max-w-[85%]">
                <TrustBadge type={trustType} />
              </div>
            </div>
          ) : (
            <div
              class="relative flex aspect-square items-center justify-center bg-gradient-to-br from-brand-50 to-ecosystem-50 text-4xl sm:aspect-[4/3]"
              aria-hidden="true"
            >
              <span>{icon}</span>
              <div class="absolute left-2 top-2 flex flex-wrap gap-1 max-w-[85%]">
                <TrustBadge type={trustType} />
              </div>
            </div>
          )
        }
        <div class="p-4">
          <p class="text-caption text-neutral-500 m-0 mb-1">{offering.category}</p>
          <h3 class="text-title-sm m-0 mb-2 line-clamp-2">{offering.name}</h3>
          <p class="text-caption text-neutral-500 m-0 mb-2">Pickup at coop counter</p>
          <div class="flex flex-wrap items-end justify-between gap-2">
            <Price amount={offering.unitPrice} />
            <PatronageAmount amount={patronage} />
          </div>
        </div>
      </a>
      <div class:list={["p-4 pt-0", layout === "list" && "sm:flex sm:items-end sm:p-4"]}>
        <Button
          type="button"
          variant="primary"
          size="sm"
          fullWidth
          class="b2c-add-to-cart"
          data-cart-item={cartPayload}
          ariaLabel={addLabel}
        >
          Add
        </Button>
      </div>
    </Card>
  )
}
