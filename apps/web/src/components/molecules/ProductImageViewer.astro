---
interface Props {
  id: string;
  src: string;
  class?: string;
}

const { id, src, class: className } = Astro.props;
const dialogId = `product-zoom-${id}`;
---

<div class="product-image-viewer">
  <button
    type="button"
    class:list={[
      "group relative block w-full overflow-hidden rounded-xl border border-neutral-200 bg-neutral-100",
      "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600",
      className,
    ]}
    data-zoom-open={dialogId}
    aria-label="View larger product image"
  >
    <img
      src={src}
      alt=""
      class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-[1.02] lg:aspect-[4/5]"
      loading="eager"
      decoding="async"
    />
    <span
      class="pointer-events-none absolute bottom-3 right-3 rounded-full bg-neutral-900/65 px-2.5 py-1 text-caption text-white backdrop-blur-sm"
    >
      Tap to zoom
    </span>
  </button>

  <dialog
    id={dialogId}
    class="image-zoom-dialog fixed inset-0 z-[100] m-0 h-full max-h-none w-full max-w-none border-0 bg-black/90 p-4 backdrop:bg-black/90"
  >
    <form method="dialog" class="flex min-h-full items-center justify-center">
      <button
        type="submit"
        class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/15 text-2xl text-white hover:bg-white/25"
        aria-label="Close image"
      >
        ×
      </button>
      <img src={src} alt="" class="max-h-[88vh] max-w-[min(960px,94vw)] object-contain" />
    </form>
  </dialog>
</div>

<script>
  import { setupProductImageZoom } from "@/scripts/product-image-zoom";
  setupProductImageZoom();
</script>
