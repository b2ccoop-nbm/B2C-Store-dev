---
import type { CatalogItemPublic } from "@b2ccoop/store-shared";
import ProductCard from "./ProductCard.astro";
import EmptyState from "@/components/atoms/EmptyState.astro";

interface Props {
  items: CatalogItemPublic[];
  emptyTitle?: string;
  /** compact = dense browse grid (default); comfortable = larger cards for highlights */
  density?: "compact" | "comfortable";
}

const { items, emptyTitle = "No products found", density = "compact" } = Astro.props;

const gridClass =
  density === "compact"
    ? "grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-2 sm:gap-3"
    : "grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4";
---

{
  items.length === 0 ? (
    <EmptyState title={emptyTitle} description="Check back soon or try another category." />
  ) : (
    <ul class:list={["grid list-none m-0 p-0", gridClass]}>
      {items.map((item) => (
        <li class="min-h-0">
          <ProductCard item={item} density={density} />
        </li>
      ))}
    </ul>
  )
}
