---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import Button from "@/components/atoms/Button.astro";
import Card from "@/components/atoms/Card.astro";
import Input from "@/components/atoms/Input.astro";
import Select from "@/components/atoms/Select.astro";
import Textarea from "@/components/atoms/Textarea.astro";
import { LISTING_CATEGORIES } from "@b2ccoop/store-shared";

const categories = [...LISTING_CATEGORIES];
---

<DashboardLayout title="New listing" section="sell">
  <header class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-display m-0">Listing wizard</h1>
      <p id="wizard-step-label" class="text-body-sm text-neutral-500 mt-2 m-0">Step 1 of 2</p>
    </div>
    <Button href="/profile" variant="ghost" size="sm">Member sign-in</Button>
  </header>

  <Card class="max-w-xl" id="listing-wizard-panel">
    <div id="wizard-step-1" class="flex flex-col gap-4">
      <p class="text-body-sm text-neutral-500 m-0">Set your suggested retail price (SRP). Coop revenue, vendor payout, and member patronage are calculated automatically.</p>
      <Input id="listing-name" name="name" type="text" label="Product name" required placeholder="Organic brown rice 5kg" />
      <Input
        id="listing-sku-prefix"
        name="skuPrefix"
        type="text"
        label="SKU prefix (optional)"
        placeholder="RICE-5KG"
        hint="Leave blank to derive from the product name. A UTC timestamp is added on save, e.g. RICE-5KG-20260722100530"
      />
      <p id="listing-sku-preview" class="text-caption text-neutral-500 m-0 font-mono" aria-live="polite" />
      <Select
        id="listing-category"
        name="category"
        label="Category"
        required
        options={categories.map((c) => ({ value: c, label: c }))}
      />
      <Input
        id="listing-price"
        name="unitPrice"
        type="text"
        label="SRP (PHP)"
        required
        inputMode="decimal"
        placeholder="199.00"
        hint="Suggested retail price — what buyers pay per item"
      />
      <div id="listing-fee-field" class="hidden">
        <Input
          id="listing-fee-percent"
          name="listingFeePercent"
          type="text"
          label="Listing fee (% of SRP)"
          inputMode="decimal"
          placeholder="10.00"
          hint="Partner sellers: coop listing fee as % of SRP. Leave blank to use your store default."
        />
      </div>
      <Select
        id="listing-delivery-tier"
        name="deliveryTier"
        label="Delivery tier"
        options={[
          { value: "standard", label: "Standard (1× platform rate)" },
          { value: "bulky", label: "Bulky (2×)" },
          { value: "remote", label: "Remote (3×)" },
        ]}
        hint="Per-item delivery fee uses product override → your store rate → tier multiplier → platform default (₱50)."
      />
      <Input
        id="listing-delivery-override"
        name="deliveryPerItem"
        type="text"
        label="Delivery override per item (PHP, optional)"
        inputMode="decimal"
        placeholder=""
        hint="Fixed per-item delivery for this product. Overrides tier calculation when set."
      />
      <label class="flex items-start gap-3 text-body-sm">
        <input id="listing-patronage-eligible" type="checkbox" checked class="mt-1" />
        <span>Eligible for member patronage on coop revenue capture</span>
      </label>
      <div id="listing-split-preview" aria-live="polite" />

      <Textarea
        id="listing-short-description"
        name="shortDescription"
        label="Short description"
        rows={4}
        hint="Shown on the product page when shoppers open this item."
      />
      <Textarea
        id="listing-highlights"
        name="highlights"
        label="Highlights"
        rows={4}
        hint="One highlight per line — e.g. refillable container, lemon scent."
      />
      <Textarea
        id="listing-features"
        name="features"
        label="Features"
        rows={4}
        hint="One feature per line — e.g. phosphate-free, 2L volume."
      />
      <p id="listing-copy-word-count" class="text-caption text-neutral-500 m-0" aria-live="polite" />

      <div>
        <p class="text-body-sm font-semibold text-neutral-800 mb-2 m-0">Product photos (up to 4)</p>
        <div class="grid gap-3 sm:grid-cols-2">
          {
            [0, 1, 2, 3].map((slot) => (
              <div class="rounded-lg border border-neutral-200 p-3">
                <label for={`listing-image-${slot}`} class="block text-caption font-semibold text-neutral-700 mb-2">
                  Photo {slot + 1}{slot === 0 ? " (cover)" : ""}
                </label>
                <input
                  id={`listing-image-${slot}`}
                  name={`image-${slot}`}
                  type="file"
                  accept="image/jpeg,image/png,image/webp"
                  class="block w-full text-caption text-neutral-700 file:mr-2 file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-1.5 file:font-semibold file:text-brand-700"
                  data-listing-image-input={slot}
                />
                <img
                  id={`listing-image-preview-${slot}`}
                  alt=""
                  class="hidden mt-2 max-h-28 w-full rounded-lg border border-neutral-200 object-contain"
                  data-listing-image-preview={slot}
                />
              </div>
            ))
          }
        </div>
        <p class="text-caption text-neutral-500 m-0 mt-2">JPEG, PNG, or WebP — max 2 MB each. Photo 1 is the catalog cover.</p>
      </div>
    </div>

    <div id="wizard-step-2" class="hidden">
      <h2 class="text-title m-0 mb-4">Review & submit</h2>
      <div id="wizard-review" />
    </div>

    <p id="wizard-error" class="hidden text-body-sm text-danger-600 mt-4 m-0" role="alert" />
    <p id="wizard-success" class="hidden text-body-sm text-success-600 mt-4 m-0" role="status" />

    <div class="flex flex-wrap gap-3 mt-6">
      <Button type="button" variant="secondary" id="wizard-back" class="hidden">Back</Button>
      <Button type="button" variant="primary" id="wizard-next">Continue</Button>
      <Button type="button" variant="primary" id="wizard-submit" class="hidden">Submit for review</Button>
    </div>
  </Card>
</DashboardLayout>

<script>
  import { setupListingWizard } from "@/scripts/listing-wizard";
  import { setupMerchantPageGate } from "@/scripts/merchant-page-gate";
  import { API_BASE } from "@/lib/api";
  setupMerchantPageGate(API_BASE, { containerId: "listing-wizard-panel" });
  setupListingWizard(API_BASE);
</script>
