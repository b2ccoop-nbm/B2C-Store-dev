---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import Button from "@/components/atoms/Button.astro";
import Card from "@/components/atoms/Card.astro";
import Input from "@/components/atoms/Input.astro";
import Select from "@/components/atoms/Select.astro";
import Textarea from "@/components/atoms/Textarea.astro";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<DashboardLayout title="Apply to sell" section="sell">
  <header class="mb-6">
    <h1 class="text-display m-0">Seller application</h1>
    <p class="text-body-sm text-neutral-500 mt-2 m-0">
      Join the B2CCoop marketplace. Officers review applications before you can publish listings.
      <a href="/profile" class="text-brand-600 font-semibold">Sign in</a> with your member account to link your application automatically.
    </p>
  </header>

  <div id="onboarding-stepper" aria-hidden="true" />

  <div id="application-success-banner" class="hidden max-w-xl mb-6 p-4 rounded-lg bg-success-50 border border-success-200" role="status" />

  <Card class="max-w-xl mb-8">
    <h2 class="text-title m-0 mb-4">New application</h2>
    <form id="seller-application-form" class="flex flex-col gap-4">
      <Input
        id="applicantEmail"
        name="applicantEmail"
        type="email"
        label="Business email"
        required
        autocomplete="email"
        hint="Use the same email you sign in with on Your profile — required for seller access without an access token."
      />
      <div id="application-email-signin-banner" class="hidden rounded-lg border px-4 py-3" role="status" aria-live="polite" />
      <Input id="businessName" name="businessName" type="text" label="Business name" required />
      <Select
        id="businessType"
        name="businessType"
        label="What do you sell?"
        required
        options={[
          { value: "product", label: "Products (goods)" },
          { value: "food", label: "Food & beverages" },
          { value: "farm", label: "Farm & produce" },
        ]}
      />
      <Input
        id="contactPhone"
        name="contactPhone"
        type="tel"
        label="Contact phone"
        inputMode="tel"
        hint="Philippine mobile, e.g. 09XX XXX XXXX"
      />
      <Textarea id="description" name="description" label="Tell us about your business" rows={4} hint="What you sell, where you're based, coop membership if any." />
      {
        turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} id="apply-turnstile" />
        )
      }
      <Button type="submit" variant="primary">Submit application</Button>
      <p id="application-error" class="hidden text-body-sm text-danger-600 m-0" role="alert" />
    </form>
  </Card>

  <div id="application-status-card">
    <Card class="max-w-xl mb-8">
      <h2 class="text-title m-0 mb-4">Application status</h2>
      <p class="text-body-sm text-neutral-500 m-0 mb-4">Sign in on <a href="/profile" class="text-brand-600 font-semibold">Your profile</a> for automatic status, or check by email below.</p>
      {
        turnstileSiteKey && (
          <div class="cf-turnstile mb-4" data-sitekey={turnstileSiteKey} id="status-turnstile" />
        )
      }
      <Input id="check-email" name="checkEmail" type="email" label="Your email" autocomplete="email" />
      <Button type="button" variant="secondary" id="check-application" class="mt-4">Check status</Button>
      <div id="application-status" class="hidden mt-4 p-4 rounded-lg bg-neutral-50 border border-neutral-100" />
    </Card>
  </div>

  <div id="merchant-sso-card" class="hidden">
    <Card class="max-w-xl mb-8">
      <h2 class="text-title m-0 mb-4">Seller access</h2>
      <p class="text-body-sm text-neutral-500 m-0 mb-2">
        Approved merchants use the same member sign-in as shoppers. Switch to <strong>Merchant</strong> in the header to manage your store.
      </p>
      <p id="merchant-sso-msg" class="hidden text-body-sm mt-2 m-0" role="status" />
      <Button href="/profile" variant="primary" class="mt-4">Sign in on Your profile</Button>
    </Card>
  </div>

  <div id="merchant-credentials-card" class="hidden">
    <Card class="max-w-xl">
      <h2 class="text-title m-0 mb-4">Access token (optional fallback)</h2>
      <p class="text-body-sm text-neutral-500 m-0 mb-4">
        Most sellers only need member sign-in. HQ may provide a token for recovery or non-Google accounts.
      </p>
      <Input id="merchant-email" name="merchantEmail" type="email" label="Contact email" autocomplete="email" />
      <Input
        id="merchant-vendor"
        name="merchantVendor"
        type="text"
        label="Vendor code"
        placeholder="Auto-filled when you save your token"
        readonly
        class="mt-4"
      />
      <Input
        id="merchant-token"
        name="merchantToken"
        type="password"
        label="Access token"
        hint="Paste the token HQ sent when your application was approved. We verify it before saving."
        autocomplete="off"
        class="mt-4"
      />
      <Button type="button" variant="primary" id="save-merchant-session" class="mt-4">Save on this device</Button>
      <p id="merchant-session-msg" class="hidden text-body-sm mt-2 m-0" role="status" />
    </Card>
  </div>
</DashboardLayout>

{turnstileSiteKey && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline />
)}

<script>
  import { setupMerchantCredentials, setupSellerApplicationForm } from "@/scripts/seller-application";
  import { API_BASE } from "@/lib/api";
  setupSellerApplicationForm(API_BASE);
  setupMerchantCredentials(API_BASE);
</script>
