---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Button from "@/components/atoms/Button.astro";
import AdminSignInPanel from "@/components/organisms/AdminSignInPanel.astro";
---

<AdminLayout title="Fulfillment queue">
  <header class="mb-6">
    <h1 class="text-display m-0">Fulfillment queue</h1>
    <p class="text-body-sm text-neutral-500 mt-2 m-0">
      Delivery and pickup orders waiting for fulfillment and ledger posting.
    </p>
  </header>

  <AdminSignInPanel />

  <Button type="button" variant="staff" id="load-pending" class="mb-4">
    Load pending orders
  </Button>
  <p id="admin-load-error" class="hidden text-body-sm text-danger-600 mb-3 m-0" role="alert" />

  <div id="order-list" class="space-y-3" />

  <p class="text-body-sm mt-8 m-0">
    <a href="/admin/merchants" class="text-brand-600 font-semibold">Merchant & listing approval →</a>
  </p>
</AdminLayout>

<script>
  import { setupAdminQueue } from "@/scripts/admin-queue";
  import { API_BASE } from "@/lib/api";
  setupAdminQueue(API_BASE);
</script>
