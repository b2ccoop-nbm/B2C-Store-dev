---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Button from "@/components/atoms/Button.astro";
import AdminSignInPanel from "@/components/organisms/AdminSignInPanel.astro";
---

<AdminLayout title="Merchant approval">
  <header class="mb-6">
    <h1 class="text-display m-0">Merchants & listings</h1>
    <p class="text-body-sm text-neutral-500 mt-2 m-0">
      Approve seller applications and new product listings. Only designated coop approvers can act here.
    </p>
  </header>

  <AdminSignInPanel />

  <p id="admin-merchants-error" class="hidden text-body-sm text-danger-600 mb-6 m-0" role="alert" />

  <div id="credentials-alert" class="hidden max-w-2xl mb-8" role="status" aria-live="polite" />

  <section class="mb-10 max-w-2xl">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
      <div>
        <h2 class="text-title m-0">Seller applications</h2>
        <p class="text-body-sm text-neutral-500 mt-1 m-0">
          Approving generates a <strong>vendor code</strong> and <strong>access token</strong> — copy both and send to the seller.
        </p>
      </div>
      <Button type="button" variant="staff" id="load-applications">Load pending</Button>
    </div>
    <div id="applications-list" />
  </section>

  <section class="mb-10 max-w-2xl">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
      <div>
        <h2 class="text-title m-0">Merchant store credentials</h2>
        <p class="text-body-sm text-neutral-500 mt-1 m-0">
          Each approved merchant has a permanent vendor code and access token. Both are shown on approval and after token rotation.
        </p>
      </div>
      <Button type="button" variant="staff" id="load-vendors">Refresh list</Button>
    </div>
    <div id="vendors-list" />
  </section>

  <section class="mb-10 max-w-2xl">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
      <h2 class="text-title m-0">Store profile changes</h2>
      <Button type="button" variant="secondary" id="load-profile-changes">Load pending</Button>
    </div>
    <div id="profile-changes-panel" />
  </section>

  <section class="max-w-2xl">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
      <h2 class="text-title m-0">Listings awaiting approval</h2>
      <Button type="button" variant="secondary" id="load-pending-listings">Load pending</Button>
    </div>
    <div id="pending-listings-panel" />
  </section>

  <p class="text-body-sm mt-8 m-0">
    <a href="/admin" class="text-brand-600 font-semibold">← Pickup queue</a>
  </p>
</AdminLayout>

<script>
  import { setupAdminMerchants } from "@/scripts/admin-merchants";
  import { API_BASE } from "@/lib/api";
  setupAdminMerchants(API_BASE);
</script>
