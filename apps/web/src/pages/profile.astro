---
import MarketplaceLayout from "@/layouts/MarketplaceLayout.astro";
import Button from "@/components/atoms/Button.astro";
import Card from "@/components/atoms/Card.astro";
import Input from "@/components/atoms/Input.astro";
import PersonaSwitcher from "@/components/organisms/shell/PersonaSwitcher.astro";
---

<MarketplaceLayout title="You" mobileHeaderTitle="You">
  <header class="mb-6">
    <h1 class="text-display m-0">You</h1>
    <p class="text-body-sm text-neutral-500 mt-2 m-0">Your coop store account and activity.</p>
  </header>

  <div class="max-w-lg space-y-4">
    <Card>
      <h2 class="text-title-sm m-0 mb-3">Quick links</h2>
      <div class="flex flex-col gap-2">
        <Button href="/activity" variant="secondary" fullWidth>My activity</Button>
        <Button href="/cart" variant="secondary" fullWidth>Cart</Button>
        <Button href="/my-coop" variant="secondary" fullWidth>My Coop</Button>
        <Button href="/sell" variant="primary" fullWidth>Seller dashboard</Button>
        <Button href="/sell/apply" variant="secondary" fullWidth>Apply to sell on B2CCoop</Button>
      </div>
    </Card>

    <Card id="member-signed-in-panel" class="hidden">
      <h2 class="text-title-sm m-0 mb-2">Signed in</h2>
      <p class="text-body-sm text-neutral-900 m-0 mb-2">
        <span id="member-signed-in-email" class="font-semibold" />
      </p>
      <p id="member-merchant-hint" class="hidden text-body-sm text-merchant-700 bg-merchant-50 border border-merchant-200 rounded-lg px-3 py-2 mb-4 m-0" />
      <Button type="button" variant="secondary" id="member-sign-out-btn" fullWidth>Sign out</Button>
    </Card>

    <Card id="member-sign-in-panel">
      <h2 class="text-title-sm m-0 mb-2">Member sign-in</h2>
      <p class="text-body-sm text-neutral-500 m-0 mb-4">
        Use the same Firebase account as the B2CCoop member portal. Signing in links your seller application and store.
      </p>
      <div class="flex flex-col gap-3">
        <Input id="member-sign-in-email" name="email" type="email" label="Email" autocomplete="email" />
        <Input id="member-sign-in-password" name="password" type="password" label="Password" autocomplete="current-password" />
        <Button type="button" variant="primary" id="member-sign-in-btn" fullWidth>Sign in</Button>
        <Button type="button" variant="secondary" id="member-google-sign-in-btn" fullWidth>Continue with Google</Button>
        <p id="member-sign-in-error" class="hidden text-body-sm text-danger-600 m-0" role="alert" />
      </div>
      <div class="flex justify-center mt-6 pt-4 border-t border-neutral-100">
        <PersonaSwitcher />
      </div>
    </Card>
  </div>
</MarketplaceLayout>

<script>
  import { setupMemberSignIn } from "@/scripts/member-sign-in";
  import { API_BASE } from "@/lib/api";
  setupMemberSignIn(API_BASE);
</script>
